# Build from the local source archive produced by scripts/source.sh.
# source.sh writes a copy of this recipe with the archive's version and SHA-256
# in target/dist; the version comes from Cargo.toml.
pkgname=squoosh-desktop
_version=REPLACED_BY_SOURCE_SCRIPT
pkgver=${_version//-/_} # pkgver does not allow the '-' of pre-releases
pkgrel=1
pkgdesc='Éditeur et convertisseur d’images local en Rust, avec traitement par lots'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'libwebp' 'libavif' 'aom' 'lcms2' 'libxkbcommon' 'libxkbcommon-x11' 'libx11' 'libxcb' 'libglvnd' 'wayland')
makedepends=('rust>=1.95' 'pkgconf' 'nasm' 'cmake')
optdepends=('xdg-desktop-portal: native file dialogs' 'xdg-desktop-portal-gtk: file chooser portal for GTK desktops')
options=('!lto') # Cargo applies its own ThinLTO; makepkg's linker-plugin LTO drops bundled C objects.
source=("$pkgname-$_version-source.tar.gz")
sha256sums=('REPLACED_BY_SOURCE_SCRIPT')

build() {
  cd "$srcdir/$pkgname-$_version"
  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --frozen -p squoosh-desktop
}
check() {
  cd "$srcdir/$pkgname-$_version"
  CARGO_TARGET_DIR="$srcdir/target" cargo test --frozen --workspace
}
package() {
  cd "$srcdir/$pkgname-$_version"
  install -Dm755 "$srcdir/target/release/squoosh-desktop" "$pkgdir/usr/bin/squoosh-desktop"
  install -Dm644 packaging/squoosh-desktop.desktop "$pkgdir/usr/share/applications/squoosh-desktop.desktop"
  install -Dm644 app/assets/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/squoosh-desktop.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 THIRD_PARTY.md "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-APACHE-2.0 "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE-2.0"
}
